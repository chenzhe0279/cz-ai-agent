# =============================================================================
# 环境变量示例（复制为 .env / .env.production 后按需修改）
# 注意：VITE_ 前缀的变量才会被 Vite 暴露到 import.meta.env，且构建时生效。
# =============================================================================

# 后端 API 基础地址。
#   本地开发：不设置即默认 http://localhost:8123/api（src/services/http.js 中有默认值）
#   云端部署：改成后端可公网访问的完整地址，例如 https://your-backend.example.com/api
#   （也可在 Docker 构建时通过 --build-arg VITE_API_BASE_URL=... 注入，优先级更高）
VITE_API_BASE_URL=http://localhost:8123/api

# -----------------------------------------------------------------------------
# 常用命令：
#   本地开发      npm run dev        # http://localhost:5173
#   本地构建      npm run build      # 产物输出到 dist/
#   云端注入构建  VITE_API_BASE_URL=https://your-backend.example.com/api npm run build
#   本地预览      npm run preview
# -----------------------------------------------------------------------------
